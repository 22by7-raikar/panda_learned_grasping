<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>grasp_learning</name>
  <version>0.1.0</version>
  <description>Learned grasp detection: multi-grasp Faster R-CNN (ResNet-50, angle-as-class) trained on Cornell, served with the same interface as the classical detector.</description>
  <maintainer email="anujpr240298@gmail.com">Anuj Pai Raikar</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>message_filters</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>
  <exec_depend>grasp_interfaces</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-pil</exec_depend>
  <!-- PyTorch and torchvision come from pip (see docker/Dockerfile); no rosdep key. -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
